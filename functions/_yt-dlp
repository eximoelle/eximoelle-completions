#compdef yt-dlp

# Completion for yt-dlp.
local curcontext="$curcontext" state context line ret=1
local -a expl state_descr
typeset -A opt_args

local -a browsers color_policies fixup_policies concat_policies sponsorblock_categories
browsers=(firefox chrome chromium brave edge safari opera vivaldi whale)
color_policies=(always auto auto-tty never no_color no_color-tty)
fixup_policies=(never warn detect_or_warn force)
concat_policies=(never always multi_video)
sponsorblock_categories=(sponsor intro outro selfpromo preview filler interaction music_offtopic hook poi_highlight chapter all default)

