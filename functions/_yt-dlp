  'general:General options:general_opts'
  'network:Network options:network_opts'
  'geo:Geo-restriction:geo_opts'
  'selection:Video selection:selection_opts'
  'download:Download options:download_opts'
  'filesystem:Filesystem options:filesystem_opts'
  'thumbnail:Thumbnail options:thumbnail_opts'
  'shortcut:Internet shortcut options:shortcut_opts'
  'verbosity:Verbosity and simulation:verbosity_opts'
  'workarounds:Workarounds:workaround_opts'
  'format:Video format options:format_opts'
  'subtitles:Subtitle options:subtitle_opts'
  'auth:Authentication options:auth_opts'
  'postproc:Post-processing options:postproc_opts'
  'sponsorblock:SponsorBlock options:sponsorblock_opts'
  'extractor:Extractor options:extractor_opts'
  'arguments:Arguments:arguments'
)

local -a all_specs
for section in $sections; do
  local arrname="${section##*:}"
  all_specs+=(${(P)arrname})
done

_arguments -s -S -C "${all_specs[@]}"
case $? in
  0|300) ret=0 ;;
esac

case $state in
  browsers) _values 'browser' $browsers && ret=0 ;;
  color) _values 'color policy' $color_policies && ret=0 ;;
  concat) _values 'concat policy' $concat_policies && ret=0 ;;
  fixup) _values 'fixup policy' $fixup_policies && ret=0 ;;
  sponsorblock) _values 'sponsorblock category' $sponsorblock_categories && ret=0 ;;
esac

return ret
