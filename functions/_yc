typeset -ga _YC_FLAG_SPECS

_yc_init_flag_specs() {
  local spec flag desc
  _YC_FLAG_SPECS=()
  for spec in ${(f)_YC_FLAGS[global]}; do
    flag=${spec%%:*}
    desc=
    [[ $spec == *:* ]] && desc=${spec#*:}
    if [[ $flag == *= ]]; then
      flag=${flag%=}
      if [[ -n $desc ]]; then
        _YC_FLAG_SPECS+=("${flag}=[${desc}]:value:")
      else
        _YC_FLAG_SPECS+=("${flag}=:value:")
      fi
    else
      if [[ -n $desc ]]; then
        _YC_FLAG_SPECS+=("${flag}[${desc}]")
      else
        _YC_FLAG_SPECS+=("${flag}")
      fi
    fi
  done
}
_yc_init_flag_specs
unset -f _yc_init_flag_specs

_yc_flag_specs_from_list() {
  local spec flag desc
  reply=()
  for spec in ${(f)$1}; do
    flag=${spec%%:*}
    desc=
    [[ $spec == *:* ]] && desc=${spec#*:}
    if [[ $flag == *= ]]; then
      flag=${flag%=}
      if [[ -n $desc ]]; then
        reply+=("${flag}=[${desc}]:value:")
      else
        reply+=("${flag}=:value:")
      fi
    else
      if [[ -n $desc ]]; then
        reply+=("${flag}[${desc}]")
      else
        reply+=("${flag}")
      fi
    fi
  done
}

_yc_flag_needs_value() {
  local flag=$1 path=$2 spec
  for spec in ${(f)_YC_FLAGS[global]}; do
    [[ $spec == ${flag}= ]] && return 0
  done
  if (( $+_YC_FLAGS[$path] )); then
    for spec in ${(f)_YC_FLAGS[$path]}; do
      [[ $spec == ${flag}= ]] && return 0
    done
  fi
  return 1
}

_yc() {
  local cur=${words[CURRENT]:-}
  local w end_opts=0
  local -a path_parts cmd_entries cmd_display flag_specs flag_display

  # Build path from already-entered non-flag words (yc <svc> <sub...>),
  # skipping the current word and flag arguments.
  path_parts=("yc")
  local i=2
  while (( i < CURRENT )); do
    w=${words[i]}
    if (( end_opts )); then
      path_parts+=$w
      (( i++ ))
      continue
    fi
    if [[ $w == -- ]]; then
      end_opts=1
      (( i++ ))
      continue
    fi
    if [[ $w == -* ]]; then
      if [[ $w == *=* ]]; then
        (( i++ ))
        continue
      fi
      local path=${(j/:/)path_parts}
      if _yc_flag_needs_value "$w" "$path" && (( i + 1 < CURRENT )); then
        (( i++ ))
      fi
      (( i++ ))
      continue
    fi
    path_parts+=$w
    (( i++ ))
  done
  local path=${(j/:/)path_parts}

  cmd_entries=()
  (( $+_YC_CMDS[$path] )) && cmd_entries=(${(f)_YC_CMDS[$path]})

  flag_specs=(${(f)_YC_FLAGS[global]})
  (( $+_YC_FLAGS[$path] )) && flag_specs+=(${(f)_YC_FLAGS[$path]})

  flag_display=()
  for w in $flag_specs; do
    local name=$w desc=
    if [[ $w == *:* ]]; then
      name=${w%%:*}
      desc=${w#*:}
    fi
    name=${name%=}
    flag_display+=("${name}:${desc}")
  done

  if [[ $cur == -* ]]; then
    (( ${#flag_display} )) && _describe -t flags 'flags' flag_display && return 0
    return 1
  fi

  if (( ${#cmd_entries} )); then
    cmd_display=()
    for w in $cmd_entries; do
      if [[ $w == *:* ]]; then
        cmd_display+=("$w")
      else
        cmd_display+=("${w}:")
      fi
    done
    _describe -t commands 'commands' cmd_display && return 0
    return 1
  fi

  (( ${#flag_display} )) && _describe -t flags 'flags' flag_display && return 0
  return 1
}
